{
  "name": "ripple-water-toy",
  "version": "1.0.0",
  "description": "Ripple — Steer a floating puck across a dark desktop pool by tapping the water around it.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node --test tests/validation.test.ts",
    "vite:dev": "vite --host",
    "vite:build": "tsc && vite build",
    "vite:preview": "vite preview --port 4173"
